# Copy this file to .env in the project root before running docker compose.
# These values are consumed by docker-compose.yml and passed into the
# backend/db containers. Defaults below are fine for local dev/demo use.

POSTGRES_USER=sentiprice
POSTGRES_PASSWORD=sentiprice_dev
POSTGRES_DB=sentiprice_db

JWT_SECRET_KEY=dev-secret-change-in-production

# Set a private password (12 characters minimum) to create the built-in admin.
ADMIN_EMAIL=admin@sentiprice.ai
ADMIN_PASSWORD=

# Enable the original fixed Admin and Analyst credentials for a local presentation.
PRESENTATION_ACCOUNTS=false
